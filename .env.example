NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
OWNER_EMAIL=you@example.com

# AI (design section 13, BYOK). Leave AI_KEY_ENCRYPTION_SECRET unset to disable AI features.
# Generate with: openssl rand -base64 32
AI_KEY_ENCRYPTION_SECRET=
# Operator-pinned model per provider. Users choose the provider in Settings, not the model.
AI_ANTHROPIC_MODEL=claude-opus-5
AI_OPENAI_MODEL=gpt-5-mini
